[{"id":812,"date":"2026-03-26T09:00:55","date_gmt":"2026-03-26T09:00:55","guid":{"rendered":"https:\/\/www.hualien.cloud\/?p=812"},"modified":"2026-03-26T09:03:47","modified_gmt":"2026-03-26T09:03:47","slug":"812","status":"publish","type":"post","link":"https:\/\/www.hualien.cloud\/uncategorized\/812\/","title":{"rendered":"\u82b1\u84ee\u4e09\u4e09\u5c0f\u805a \u3010\u4e09\u6708\u3011"},"content":{"rendered":"\n<div class=\"wp-block-media-text is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img loading=\"lazy\" decoding=\"async\" width=\"571\" height=\"1024\" src=\"https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831-571x1024.png\" alt=\"\" class=\"wp-image-813 size-full\" srcset=\"https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831-571x1024.png 571w, https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831-167x300.png 167w, https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831-768x1377.png 768w, https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831-857x1536.png 857w, https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831-7x12.png 7w, https:\/\/www.hualien.cloud\/wp-content\/uploads\/2026\/03\/33\u5c0f\u805a-\u6d77\u5831.png 1142w\" sizes=\"auto, (max-width: 571px) 100vw, 571px\" \/><\/figure><div class=\"wp-block-media-text__content\">\n<div class=\"wp-block-uagb-tabs uagb-block-5c58c9e3 uagb-tabs__wrap uagb-tabs__hstyle1-desktop uagb-tabs__vstyle6-tablet uagb-tabs__stack1-mobile\" data-tab-active=\"0\"><ul class=\"uagb-tabs__panel uagb-tabs__align-left\" role=\"tablist\"><li class=\"uagb-tab uagb-tabs__active\" role=\"none\"><a href=\"#uagb-tabs__tab0\" class=\"uagb-tabs-list uagb-tabs__icon-position-left\" data-tab=\"0\" role=\"tab\"><div>\u4e2d\u6587<\/div><\/a><\/li><li class=\"uagb-tab \" role=\"none\"><a href=\"#uagb-tabs__tab1\" class=\"uagb-tabs-list uagb-tabs__icon-position-left\" data-tab=\"1\" role=\"tab\"><div>English<\/div><\/a><\/li><\/ul><div class=\"uagb-tabs__body-wrap\">\n<div class=\"wp-block-uagb-tabs-child uagb-tabs__body-container uagb-inner-tab-0\" aria-labelledby=\"uagb-tabs__tab0\">\n<p>\u2726 \u6bcf\u6708\u7b2c\u4e09\u500b\u661f\u671f\u4e09\uff0c\u6211\u5011\u76f8\u805a<br>\u2726 \u4f60\u6709\u591a\u4e45\uff0c\u6c92\u6709\u771f\u6b63\u300c\u4e0b\u73ed\u300d\u4e86\uff1f<br>\u4e00\u908a\u65c5\u884c\u3001\u4e00\u908a\u5de5\u4f5c\uff0c\u807d\u8d77\u4f86\u5f88\u81ea\u7531\u2014\u2014<br>\u4f46\u53ea\u6709\u6578\u4f4d\u904a\u7267\u8005\u81ea\u5df1\u77e5\u9053\uff1a<br>\u4e0d\u65b7\u63db\u57ce\u5e02\uff0c\u5f88\u96e3\u5efa\u7acb\u6df1\u5ea6\u7684\u95dc\u4fc2\uff1b<br>\u96a8\u6642\u96a8\u5730\u53ef\u4ee5\u5de5\u4f5c\uff0c\u537b\u8b8a\u6210\u96a8\u6642\u96a8\u5730\u90fd\u5728\u5de5\u4f5c\uff1b<br>\u4e00\u6574\u5929\u76ef\u8457\u87a2\u5e55\uff0c\u8eab\u9ad4\u50f5\u786c\u3001\u6642\u5dee\u6df7\u4e82\uff1b<br>\u5708\u5b50\u88e1\u7030\u6f2b\u8457\u300c\u6211\u8981\u505a\u66f4\u591a\u300d\u7684\u7126\u616e\uff0c\u4e0d\u5141\u8a31\u81ea\u5df1\u6162\u4e0b\u4f86\uff1b<br>\u6bcf\u5230\u4e00\u500b\u65b0\u5730\u65b9\u5c31\u8981\u91cd\u65b0\u9069\u61c9\uff0c\u5167\u5fc3\u5e38\u5e38\u611f\u5230\u6f02\u6d6e\u548c\u5931\u63a7\u3002<br>\u770b\u4f3c\u81ea\u7531\u7684\u751f\u6d3b\u5e95\u4e0b\uff0c\u85cf\u8457\u75b2\u618a<br>\u9019\u500b\u4e09\u6708\uff0c\u4e09\u4e09\u5c0f\u805a\u9080\u8acb\u4f60\u6309\u4e0b\u66ab\u505c\u9375\u3002<br>\u51a5\u60f3\uff0c\u4e0d\u9700\u8981\u56fa\u5b9a\u5730\u9ede\uff0c\u4e0d\u9700\u8981\u4efb\u4f55\u5668\u6750\uff0c<br>\u53ea\u9700\u8981\u4f60\u7684\u8eab\u9ad4\u548c\u547c\u5438\u2014\u2014<br>\u5b83\u662f\u4f60\u5728\u4e0d\u65b7\u79fb\u52d5\u7684\u751f\u6d3b\u4e2d\uff0c\u552f\u4e00\u53ef\u4ee5\u5e36\u8457\u8d70\u7684\u300c\u5bb6\u300d\u3002<br>\u51a5\u60f3\u5e2b\u300c\u4e39\u5c3c\u723e\u5148\u751f\u300d\u64c5\u9577\u5c07\u8eab\u5fc3\u9748\u77e5\u8b58\u843d\u5730\u5be6\u8e10\uff0c<br>\u7528\u6eab\u6696\u3001\u5305\u5bb9\u7684\u5f15\u5c0e\u65b9\u5f0f\uff0c<br>\u5e36\u4f60\u5728\u5916\u5728\u4e0d\u65b7\u8b8a\u52d5\u7684\u751f\u6d3b\u4e2d\uff0c\u627e\u5230\u4e00\u500b\u7a69\u5b9a\u7684\u5167\u5728\u5b9a\u9328\u3002<br>\u8b93\u5927\u8166\u771f\u6b63\u4f11\u606f\uff0c<br>\u91cd\u65b0\u611f\u53d7\u300c\u6b64\u523b\u3001\u6b64\u5730\u300d\u7684\u81ea\u5df1\uff0c<br>\u800c\u4e0d\u662f\u6c38\u9060\u6d3b\u5728\u4e0b\u4e00\u500b\u76ee\u7684\u5730\u7684\u8a08\u756b\u88e1\u3002<\/p>\n\n\n\n<p>\ud83d\udcc5 \u65e5\u671f\uff1a2026\u5e743\u670818\u65e5\uff08\u4e09\uff0918:30\u201320:00<br>\ud83d\udccd \u5730\u9ede\uff1a\u82b1\u84ee\u96f2\u57fa\u5730\uff08\u82b1\u84ee\u7e23\u82b1\u84ee\u5e02\u5e9c\u524d\u8def3\u865f\uff09<br>\ud83c\udfdb \u4e3b\u8fa6\u55ae\u4f4d\uff1a\u82b1\u84ee\u7e23\u653f\u5e9c<br>\ud83c\udfe2 \u57f7\u884c\u55ae\u4f4d\uff1a\u904a\u904a\u80a1\u4efd\u6709\u9650\u516c\u53f8<\/p>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-tabs-child uagb-tabs__body-container uagb-inner-tab-1\" aria-labelledby=\"uagb-tabs__tab1\">\n<p>\u2726 We meet on the third Wednesday of every month<\/p>\n\n\n\n<p>\u2726 How long has it been since you truly &#8220;left work&#8221;?<\/p>\n\n\n\n<p>Traveling while working sounds liberating\u2014<\/p>\n\n\n\n<p>But only a few nomads know:<\/p>\n\n\n\n<p>Constantly moving cities makes it difficult to build deep relationships;<br>Working anytime, anywhere becomes working all the time;<br>Staring at a screen all day leaves you stiff and jet-lagged;<br>An anxiety of &#8220;I have to do more&#8221; permeates your social circle, preventing you from slowing down;<br>Every new place requires readjustment, often leaving you feeling adrift and out of control.<\/p>\n\n\n\n<p>Beneath this seemingly free life lies exhaustion.<\/p>\n\n\n\n<p>This March, our &#8220;Three-Three Gathering&#8221; invites you to press pause.<\/p>\n\n\n\n<p>Meditation requires no fixed location, no equipment,<\/p>\n\n\n\n<p>only your body and breath\u2014<\/p>\n\n\n\n<p>It&#8217;s the only &#8220;home&#8221; you can take with you in your constantly moving life.<\/p>\n\n\n\n<p>Meditation master &#8220;Mr. Daniel&#8221; excels at putting mind-body-spirit knowledge into practice,<\/p>\n\n\n\n<p>using a warm and inclusive guiding approach,<\/p>\n\n\n\n<p>to help you find a stable inner anchor in your ever-changing life.<\/p>\n\n\n\n<p>Let your brain truly rest, and rediscover yourself in the &#8220;here and now,&#8221; instead of forever living in plans for the next destination.<\/p>\n\n\n\n<p>\ud83d\udcc5 Date: March 18, 2026 (Wednesday) 18:30\u201320:00<\/p>\n\n\n\n<p>\ud83d\udccd Location: Hualien Cloud Base (No. 3, Fuqian Road, Hualien City, Hualien County)<\/p>\n\n\n\n<p>\ud83c\udfdb Organizer: Hualien County Government<\/p>\n\n\n\n<p>\ud83c\udfe2 Executive Unit: Youyou Co., Ltd.<\/p>\n<\/div>\n<\/div><\/div>\n<\/div><\/div>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":7,"featured_media":0,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_uag_custom_page_level_css":"","footnotes":""},"categories":[1],"tags":[],"class_list":["post-812","post","type-post","status-publish","format-standard","hentry","category-uncategorized"],"blocksy_meta":[],"uagb_featured_image_src":{"full":false,"thumbnail":false,"medium":false,"medium_large":false,"large":false,"1536x1536":false,"2048x2048":false,"trp-custom-language-flag":false},"uagb_author_info":{"display_name":"Liann","author_link":"https:\/\/www.hualien.cloud\/author\/liann\/"},"uagb_comment_info":1,"uagb_excerpt":null,"_links":{"self":[{"href":"https:\/\/www.hualien.cloud\/wp-json\/wp\/v2\/posts\/812","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.hualien.cloud\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.hualien.cloud\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.hualien.cloud\/wp-json\/wp\/v2\/users\/7"}],"replies":[{"